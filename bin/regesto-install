#!/usr/bin/env bash
# Install this instance's adapters into the agents on this machine:
#   1. symlink adapters/skills/* into each agent's skills directory (PLAN 1.d)
#   2. register the SessionStart hook in the agent's settings file (PLAN 1.c)
#   3. add the KB section to each agent's instructions file (PLAN 1.e)
#
# Idempotent: re-running changes nothing once installed.
#
# This script hardcodes NO paths. Every location comes from `regesto config`,
# which applies per-vendor defaults and any [skills_dirs] / [instructions] /
# [settings_files] overrides from config.toml. That is what makes it publishable
# as Phase 4's `init` (PLAN 4.a) rather than a script that only fits one machine.
#
# Symlinks live outside the synced folder and point into it, so the sync client
# only ever sees real files (DECISION §9.0).
#
# Usage:  bin/regesto-install [--dry-run] [--config <path>]
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY=0
CONFIG="$ROOT/config.toml"
while (( $# )); do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --config)  CONFIG="${2:?--config needs a path}"; shift 2 ;;
    *)         printf 'usage: %s [--dry-run] [--config <path>]\n' "$(basename "$0")" >&2; exit 2 ;;
  esac
done

say()  { printf '%s\n' "$*"; }
act()  { if (( DRY )); then say "  would: $*"; else say "  $*"; fi; }
warn() { printf '  ! %s\n' "$*" >&2; }

# realpath that tolerates a not-yet-existing target.
real() { readlink -f "$1" 2>/dev/null || printf '%s\n' "$1"; }

# --- find the engine ---------------------------------------------------------
# An instance is knowledge; the engine is a binary. It can arrive three ways,
# and the hook runs on every session start, so whichever it is has to be a
# binary and not `go run` — ~50ms against ~900ms, which is the whole reason
# decision 0.11 picked Go (DECISION §12's latency warning).
say "engine"
ENGINE=""
if [[ -f "$ROOT/go.mod" && -d "$ROOT/cmd/regesto" ]]; then
  # This instance is also an engine checkout. The binary is deliberately not
  # committed, so installing builds it.
  if [[ -x "$ROOT/bin/regesto" ]] && [[ -z "$(find "$ROOT/cmd" "$ROOT/internal" -name '*.go' -newer "$ROOT/bin/regesto" -print -quit 2>/dev/null)" ]]; then
    say "  ok   bin/regesto is up to date"
    ENGINE="$ROOT/bin/regesto"
  elif command -v go >/dev/null 2>&1; then
    act "build bin/regesto"
    if (( ! DRY )) && ! (cd "$ROOT" && go build -o bin/regesto ./cmd/regesto); then
      warn "build failed"
      exit 1
    fi
    ENGINE="$ROOT/bin/regesto"
  elif [[ -x "$ROOT/bin/regesto" ]]; then
    warn "go not found — keeping the existing bin/regesto, which may be stale"
    ENGINE="$ROOT/bin/regesto"
  fi
elif [[ -x "$ROOT/bin/regesto" ]]; then
  say "  ok   bin/regesto"
  ENGINE="$ROOT/bin/regesto"
elif command -v regesto >/dev/null 2>&1; then
  ENGINE="$(command -v regesto)"
  say "  ok   $ENGINE (on PATH)"
fi
if [[ -z "$ENGINE" ]]; then
  warn "no regesto engine found. Install a release, or build one from a checkout:"
  warn "  go build -o $ROOT/bin/regesto ./cmd/regesto"
  exit 1
fi

# --- put `regesto` on PATH ---------------------------------------------------
# A symlink into a directory already on PATH, rather than editing a shell rc:
# nothing to undo, no reload, and it survives rebuilds because the link points at
# a path rather than a copy. The binary finds its own instance from its location,
# so `regesto` works from any directory. Skipped when the engine already came
# from PATH — there is nothing to add.
say
say "regesto on PATH"
if [[ "$ENGINE" != "$ROOT/bin/regesto" ]]; then
  say "  ok   already on PATH at $ENGINE"
else
link_dir=""
for candidate in "$HOME/.local/bin" "$HOME/bin" /usr/local/bin /opt/homebrew/bin; do
  case ":$PATH:" in *":$candidate:"*) ;; *) continue ;; esac
  [[ -d "$candidate" && -w "$candidate" ]] || continue
  link_dir="$candidate"; break
done
if [[ -z "$link_dir" ]]; then
  warn "no writable directory on PATH found. Add one, e.g.:"
  warn "  mkdir -p ~/.local/bin && echo 'export PATH=\"\$HOME/.local/bin:\$PATH\"' >> ~/.zshrc"
  warn "…then re-run, or call the binary by its full path: $ROOT/bin/regesto"
else
  link="$link_dir/regesto"
  if [[ -L "$link" && "$(real "$link")" == "$(real "$ROOT/bin/regesto")" ]]; then
    say "  ok   $link"
  elif [[ -e "$link" && ! -L "$link" ]]; then
    warn "$link exists and is not a symlink — leaving it alone"
  else
    act "link $link -> bin/regesto"
    (( DRY )) || ln -sf "$ROOT/bin/regesto" "$link"
  fi
fi
fi

# --- resolved instance config, straight from the engine ----------------------
# On a dry run the binary may not have been built yet; fall back to source so a
# dry run still reports real values instead of failing.
if [[ -x "$ENGINE" ]]; then
  CONF="$("$ENGINE" --config "$CONFIG" config)" || exit 1
else
  CONF="$(go -C "$ROOT" run ./cmd/regesto --config "$CONFIG" config)" || exit 1
fi
conf() { printf '%s\n' "$CONF" | sed -n "s|^$1=||p" | head -1; }

MACHINE="$(conf machine)"
MACHINE_SRC="$(conf machine_source)"
AGENTS="$(conf agents)"

# How this instance's root is written into the files handed to agents. Tilde
# form when it sits under $HOME: skills and instructions are routinely shared
# across machines via a dotfiles repo, where an absolute /Users/<someone> path
# is wrong everywhere but here.
ROOT_DISPLAY="$ROOT"
[[ "$ROOT" == "$HOME/"* ]] && ROOT_DISPLAY="~${ROOT#"$HOME"}"

# Substitute the instance's values into a shipped template. {{machine}} is
# deliberately NOT substituted — a machine name baked into a shared file is
# wrong on every other machine, so templates name the resolving command instead.
render() { sed -e "s|{{kb_root}}|$ROOT_DISPLAY|g" "$1"; }

say "instance: root=$ROOT machine=$MACHINE (from $MACHINE_SRC) agents=[${AGENTS// /, }]"
if [[ "$MACHINE_SRC" == "hostname" ]]; then
  warn "machine name guessed from the hostname, which drifts on macOS."
  warn "Pin it: echo <name> > $ROOT/.state/machine   (per-machine, never synced)"
fi

# --- 1. skills ---------------------------------------------------------------
# The shipped skills carry {{kb_root}} rather than a resolved path, so they are
# the same file in every instance. They are therefore rendered per instance
# before they can be linked. The rendered copies live in .state/, which is
# per-machine and never synced or committed — a resolved path is a local fact.
# Consequence: editing a skill under adapters/ needs a re-run of this script to
# reach the agents, exactly as an edit to the instructions template does.
STAGE="$ROOT/.state/skills"
say
say "skills → rendered into .state/skills"
for src in "$ROOT"/adapters/skills/*/; do
  [[ -d "$src" ]] || continue
  name="$(basename "$src")"
  changed=0
  while IFS= read -r rel; do
    out="$STAGE/$name/$rel"
    if [[ "$rel" == *.md ]]; then
      new="$(render "$src$rel")"
    else
      new="$(cat "$src$rel")"
    fi
    [[ -f "$out" && "$(cat "$out")" == "$new" ]] && continue
    changed=1
    (( DRY )) && continue
    mkdir -p "$(dirname "$out")"
    printf '%s\n' "$new" > "$out"
  done < <(cd "$src" && find . -type f -not -name '.*' | sed 's|^\./||')
  if (( changed )); then act "  render $name"; else say "    ok   $name up to date"; fi
done
# Drop renders whose source skill is gone, so a removed skill does not linger.
if [[ -d "$STAGE" ]]; then
  for old in "$STAGE"/*/; do
    [[ -d "$old" ]] || continue
    name="$(basename "$old")"
    [[ -d "$ROOT/adapters/skills/$name" ]] && continue
    act "  drop  $name (no longer shipped)"
    (( DRY )) || rm -rf "$old"
  done
fi

say
say "skills → agent skills directories"
for agent in $AGENTS; do
  dir="$(conf "agent.$agent.skills_dir")"
  if [[ -z "$dir" ]]; then
    warn "$agent: no skills dir known — set [skills_dirs].$agent in config.toml"
    continue
  fi
  # The declared dir may itself be a symlink into a shared home; report where
  # files actually land so the install is not quietly indirect.
  resolved="$(real "$dir")"
  note=""
  [[ "$resolved" != "$dir" ]] && note="  (→ $resolved)"
  if [[ ! -d "$(dirname "$resolved")" ]]; then
    say "  skip $agent — $(dirname "$dir") not present on this machine"
    continue
  fi
  say "  $agent: $dir$note"
  (( DRY )) || mkdir -p "$resolved"

  # Prune links this instance created that no longer resolve — a skill that was
  # renamed or removed otherwise leaves a dangling entry in the agent's skills
  # directory. Scoped to links pointing into THIS instance, so a broken link
  # belonging to anything else is left alone.
  for old in "$resolved"/*; do
    [[ -L "$old" ]] || continue
    tgt="$(readlink "$old")"
    [[ "$tgt" == "$STAGE/"* || "$tgt" == "$ROOT/adapters/skills/"* ]] || continue
    [[ -e "$tgt" ]] && continue
    act "  prune $(basename "$old") (dangling → $(basename "$tgt"))"
    (( DRY )) || rm -f "$old"
  done
  for src in "$ROOT"/adapters/skills/*/; do
    [[ -d "$src" ]] || continue
    name="$(basename "$src")"
    dest="$resolved/$name"
    want="$STAGE/$name"
    if [[ -L "$dest" ]]; then
      if [[ "$(real "$dest")" == "$(real "$want")" ]]; then say "    ok   $name"; continue; fi
      # A link straight at adapters/skills/ is this instance's own, from before
      # skills were rendered. Repoint it rather than warning about it.
      if [[ "$(readlink "$dest")" == "$ROOT/adapters/skills/"* ]]; then
        act "  relink $name (was pointing at the unrendered source)"
        (( DRY )) || ln -sfn "$want" "$dest"
        continue
      fi
      warn "  $name → $(readlink "$dest") points elsewhere — leaving it alone"; continue
    fi
    if [[ -e "$dest" ]]; then warn "  $name exists and is not a symlink — leaving it alone"; continue; fi
    act "  link $name"
    (( DRY )) || ln -s "$want" "$dest"
  done
done

# --- 2. SessionStart hook ----------------------------------------------------
say
say "SessionStart hook → agent settings"
HOOK="$ROOT/adapters/claude/hooks/session-start.sh"
for agent in $AGENTS; do
  settings="$(conf "agent.$agent.settings")"
  [[ -z "$settings" ]] && continue   # agent has no hook mechanism
  if [[ ! -x "$HOOK" ]]; then warn "hook not executable: $HOOK"; break; fi
  if ! command -v jq >/dev/null 2>&1; then
    warn "jq not found — add to $settings by hand:"
    warn '  "hooks": { "SessionStart": [ { "hooks": [ { "type": "command", "command": "'"$HOOK"'" } ] } ] }'
    break
  fi
  if [[ -f "$settings" ]] && jq -e --arg h "$HOOK" \
       '[.hooks.SessionStart[]?.hooks[]?.command] | index($h)' "$settings" >/dev/null 2>&1; then
    say "  ok   $agent already registered"
    continue
  fi
  act "register hook for $agent in $settings (backing up first)"
  (( DRY )) && continue
  [[ -f "$settings" ]] || { mkdir -p "$(dirname "$settings")"; printf '{}\n' > "$settings"; }
  backup="$settings.regesto-backup.$(date +%Y%m%d%H%M%S)"
  cp "$settings" "$backup"
  tmp="$(mktemp)"
  # Append to any existing SessionStart hooks rather than replacing them.
  if jq --arg h "$HOOK" \
       '.hooks.SessionStart = ((.hooks.SessionStart // []) + [{"hooks":[{"type":"command","command":$h}]}])' \
       "$settings" > "$tmp" && jq empty "$tmp"; then
    mv "$tmp" "$settings"
    say "  backup at $backup"
  else
    rm -f "$tmp"; warn "jq merge failed — $settings left untouched"
  fi
done

# --- 3. instructions ---------------------------------------------------------
say
say "KB section → agent instructions"
TEMPLATE="$ROOT/adapters/instructions/regesto-section.md"
SECTION_START='regesto:section:start'
SECTION_END='regesto:section:end'
if [[ ! -f "$TEMPLATE" ]]; then
  warn "missing $TEMPLATE"
else
  # Agents commonly share one instructions file via symlinks (e.g. both
  # pointing into a dotfiles repo). Dedupe by real path so the section is
  # appended once, not once per agent.
  declare -a seen=()
  for agent in $AGENTS; do
    declared="$(conf "agent.$agent.instructions")"
    [[ -z "$declared" ]] && continue
    target="$(real "$declared")"
    dup=0
    for s in ${seen+"${seen[@]}"}; do [[ "$s" == "$target" ]] && dup=1; done
    if (( dup )); then say "  ok   $agent shares $target — already handled"; continue; fi
    seen+=("$target")

    note=""
    [[ "$target" != "$declared" ]] && note="  (→ $target)"
    if [[ ! -f "$target" ]]; then
      warn "$agent: no instructions file at $declared$note — create it, or set [instructions].$agent"
      continue
    fi
    rendered="$(mktemp)"
    render "$TEMPLATE" > "$rendered"

    if ! grep -qE "$SECTION_START" "$target"; then
      act "append KB section for $agent to $declared$note"
      (( DRY )) || { printf '\n'; cat "$rendered"; } >> "$target"
      rm -f "$rendered"
      continue
    fi

    # A section is already present. Compare content, not just presence: this file
    # is always loaded, so a stale copy actively misdirects every session, which
    # is worse than having no section at all (PLAN 1.e). This matters on every
    # upgrade, not just once — any edit to the template has to reach instances
    # that already installed an older copy.
    installed="$(awk -v s="$SECTION_START" -v e="$SECTION_END" \
      '$0 ~ s {f=1} f {print} $0 ~ e {f=0}' "$target")"
    if [[ "$installed" == "$(cat "$rendered")" ]]; then
      say "  ok   $agent section up to date in $target"
      rm -f "$rendered"
      continue
    fi

    act "update stale KB section for $agent in $declared$note"
    if (( ! DRY )); then
      backup="$target.regesto-backup.$(date +%Y%m%d%H%M%S)"
      cp "$target" "$backup"
      tmp="$(mktemp)"
      # Replace everything between the markers, inclusive, leaving the rest of
      # the file untouched. Handles the pre-rename marker spelling too.
      if awk -v s="$SECTION_START" -v e="$SECTION_END" -v newfile="$rendered" '
           $0 ~ s { f=1; while ((getline line < newfile) > 0) print line; close(newfile); next }
           $0 ~ e { f=0; next }
           !f     { print }
         ' "$target" > "$tmp" && grep -qE "$SECTION_START" "$tmp"; then
        mv "$tmp" "$target"
        say "  backup at $backup"
      else
        rm -f "$tmp"
        warn "section replace failed — $target left untouched (backup at $backup)"
      fi
    fi
    rm -f "$rendered"
  done
fi

say
if (( DRY )); then
  say "dry run — nothing changed. Re-run without --dry-run to apply."
else
  say "done. Open a new session in a project to see its facts injected."
fi
