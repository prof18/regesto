#!/usr/bin/env bash
# Thin launcher for `regesto install`. In an engine checkout a real install builds the binary that hooks
# need, while a dry run is served from source and remains inert.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dry=0
config="$root/config.toml"
forward=()
while (( $# )); do
  case "$1" in
    --config)
      [[ $# -ge 2 ]] || { printf '%s: --config needs a path\n' "$(basename "$0")" >&2; exit 2; }
      config="$2"
      shift 2
      ;;
    --dry-run)
      dry=1
      forward+=("$1")
      shift
      ;;
    *)
      forward+=("$1")
      shift
      ;;
  esac
done

if [[ -f "$root/go.mod" ]]; then
  engine="$root/bin/regesto"
  if command -v go >/dev/null 2>&1; then
    if (( ! dry )) && { [[ ! -x "$engine" ]] || [[ -n "$(find "$root/cmd" "$root/internal" -name '*.go' -newer "$engine" -print -quit 2>/dev/null)" ]]; }; then
      go -C "$root" build -o "$engine" ./cmd/regesto
    fi
  elif [[ ! -x "$engine" ]]; then
    printf '%s: Go is unavailable and no existing checkout engine is executable at %s\n' "$(basename "$0")" "$engine" >&2
    exit 127
  fi

  link=""
  for candidate in "$HOME/.local/bin" "$HOME/bin" /usr/local/bin /opt/homebrew/bin; do
    case ":$PATH:" in *":$candidate:"*) ;; *) continue ;; esac
    [[ -d "$candidate" && -w "$candidate" ]] || continue
    link="$candidate/regesto"
    break
  done
  if [[ -n "$link" ]]; then
    forward+=("--engine-link" "$link" "--engine-target" "$engine")
  else
    printf '%s: no writable directory on PATH; engine link is not planned\n' "$(basename "$0")" >&2
  fi

  if (( dry )) && command -v go >/dev/null 2>&1; then
    exec go -C "$root" run ./cmd/regesto --config "$config" install "${forward[@]}"
  fi
  exec "$engine" --config "$config" install "${forward[@]}"
fi
if [[ -x "$root/bin/regesto" ]]; then
  exec "$root/bin/regesto" --config "$config" install "${forward[@]}"
fi
if command -v regesto >/dev/null 2>&1; then
  exec regesto --config "$config" install "${forward[@]}"
fi
printf '%s: no regesto engine found. Install it, or build one here with:\n  go build -o bin/regesto ./cmd/regesto\n' "$(basename "$0")" >&2
exit 127
